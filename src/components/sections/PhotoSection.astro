---
import { Image, getImage } from 'astro:assets';
import instagramIcon from '../../assets/icons/instagram.svg?raw';
import type { PhotoGearItem as PhotoGearItemType } from '../../data/portfolioData';
import { photographyCollections } from '../../data/photography';
import type { Translations } from '../../i18n/translations';

const { gear, t } = Astro.props as { gear: PhotoGearItemType[]; t: Translations };

const galleryHref = t.lang === 'en' ? '/en/photographie' : '/photographie';

// A short, hand-picked reel shown in the viewfinder; falls back gracefully if
// a file is renamed.
const reelTitles = [
	'Formica lugubris',
	'Allothrombium sp.',
	'Camponotus lateralis',
	'Malacosoma neustria',
	'Platycnemis pennipes',
	'Cataglyphis sp. gr. bicolor'
];
const macroItems = photographyCollections.find((collection) => collection.id === 'macrophotography')?.items ?? [];
const reel = reelTitles
	.map((title) => macroItems.find((item) => item.title === title))
	.filter((item) => item !== undefined);

// Higher-resolution renditions for the loupe, fetched only when it is used.
const zoomSources = await Promise.all(
	reel.map((item) => getImage({ src: item.image, width: Math.min(2600, item.image.width) }))
);
---

<section id="photo" class="relative z-10 mx-auto w-full max-w-6xl px-6 pb-24">
	<div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
		<div data-reveal>
			<p class="text-xs uppercase tracking-[0.35em] text-[color:var(--macro-amber)]">{t.photo.label}</p>
			<h2 class="mt-3 text-3xl font-semibold md:text-4xl">{t.photo.title}</h2>
			<p class="mt-4 text-[color:var(--ink-1)]">
				{t.photo.subtitle} <span class="loupe-hint">{t.photo.loupe_hint}</span>
			</p>

			<dl class="exif mt-8">
				{gear.map((item) => (
					<div class="exif__row">
						<dt>{item.label}</dt>
						<dd>
							<a href={item.url} target="_blank" rel="noreferrer">{item.name}</a>
						</dd>
					</div>
				))}
			</dl>

			<div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-4">
				<a href={galleryHref} class="macro-cta">
					{t.photo.cta_portfolio}
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
				<div class="macro-links">
					<a href="https://www.inaturalist.org/people/anathos_" target="_blank" rel="noreferrer" class="macro-link">
						iNaturalist
					</a>
					<span class="macro-links__sep" aria-hidden="true"></span>
					<a href="https://www.instagram.com/anathos_microcosmos/" target="_blank" rel="noreferrer" class="macro-link">
						<span class="inline-flex h-4 w-4" aria-hidden="true" set:html={instagramIcon}></span>
						Instagram
					</a>
				</div>
			</div>
		</div>

		<div data-reveal style="--reveal-d:140ms">
			<div
				class="viewfinder"
				data-viewfinder
				role="region"
				aria-roledescription="carousel"
				aria-label={t.photo.viewfinder_sr}
			>
				<div class="viewfinder__stage" data-vf-stage>
					{reel.map((item, i) => (
						<figure class:list={['viewfinder__slide', i === 0 && 'is-active']} data-vf-slide data-title={item.title} data-zoom-src={zoomSources[i].src} aria-hidden={i === 0 ? 'false' : 'true'}>
							<Image
								src={item.image}
								alt={item.alt}
								width={1280}
								height={Math.round(1280 / item.aspectRatio)}
								class="viewfinder__img"
								loading={i === 0 ? 'eager' : 'lazy'}
							/>
						</figure>
					))}
					<div class="viewfinder__loupe" data-vf-loupe aria-hidden="true"></div>
				</div>

				<div class="viewfinder__hud" aria-hidden="true">
					<span class="viewfinder__corner viewfinder__corner--tl"></span>
					<span class="viewfinder__corner viewfinder__corner--tr"></span>
					<span class="viewfinder__corner viewfinder__corner--bl"></span>
					<span class="viewfinder__corner viewfinder__corner--br"></span>
					<span class="viewfinder__reticle" data-vf-reticle></span>

					<span class="viewfinder__top viewfinder__top--left">
						<span class="viewfinder__rec"></span>{t.photo.hud_mode}
					</span>
					<span class="viewfinder__top viewfinder__top--right" data-vf-counter>
						01 / {String(reel.length).padStart(2, '0')}
					</span>
				</div>

				<div class="viewfinder__footer">
					<div class="min-w-0">
						<p class="viewfinder__taxon" data-vf-title aria-live="polite">{reel[0]?.title}</p>
						<p class="viewfinder__af" aria-hidden="true">
							<span class="viewfinder__af-dot"></span>{t.photo.hud_af}
						</p>
					</div>
					<a href={galleryHref} class="viewfinder__gallery">
						{t.photo.hud_gallery}
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M7 17L17 7M17 7H8M17 7v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</div>

				<div class="viewfinder__progress">
					{reel.map((item, i) => (
						<button
							type="button"
							class="viewfinder__seg"
							data-vf-seg={i}
							aria-label={`${t.photo.slide_go} ${i + 1} — ${item.title}`}
							aria-current={i === 0 ? 'true' : 'false'}
						>
							<span></span>
						</button>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const root = document.querySelector<HTMLElement>('[data-viewfinder]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
	const SLIDE_MS = 5200;

	if (root) {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-vf-slide]')];
		const segs = [...root.querySelectorAll<HTMLButtonElement>('[data-vf-seg]')];
		const stage = root.querySelector<HTMLElement>('[data-vf-stage]')!;
		const loupe = root.querySelector<HTMLElement>('[data-vf-loupe]')!;
		const title = root.querySelector<HTMLElement>('[data-vf-title]')!;
		const counter = root.querySelector<HTMLElement>('[data-vf-counter]')!;
		const total = String(slides.length).padStart(2, '0');

		let current = 0;
		let elapsed = 0;
		let last = 0;
		let paused = false;
		let visible = false;

		root.style.setProperty('--slide-ms', `${SLIDE_MS}ms`);

		// High-res layer on top, the already-loaded slide underneath while it loads.
		const loupeLayers = () => {
			const slide = slides[current];
			const img = slide.querySelector('img') as HTMLImageElement;
			const base = `url("${img.currentSrc || img.src}")`;
			return slide.dataset.zoomSrc ? `url("${slide.dataset.zoomSrc}"), ${base}` : base;
		};

		const go = (index: number) => {
			current = (index + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				slide.classList.toggle('is-active', i === current);
				slide.setAttribute('aria-hidden', String(i !== current));
			});
			segs.forEach((seg, i) => {
				seg.setAttribute('aria-current', String(i === current));
				seg.classList.toggle('is-done', i < current);
				seg.style.setProperty('--p', i < current ? '1' : '0');
			});
			title.textContent = slides[current].dataset.title ?? '';
			counter.textContent = `${String(current + 1).padStart(2, '0')} / ${total}`;
			elapsed = 0;

			// Restart the focus-pull sequence (blurred → AF lock).
			root.classList.remove('is-locked');
			root.classList.remove('is-focusing');
			void root.offsetWidth;
			root.classList.add('is-focusing');
			window.setTimeout(() => {
				root.classList.remove('is-focusing');
				root.classList.add('is-locked');
			}, reduceMotion ? 0 : 1600);

			const next = slides[(current + 1) % slides.length].querySelector('img');
			if (next) next.loading = 'eager';
		};

		const tick = (now: number) => {
			const delta = last ? now - last : 0;
			last = now;
			if (visible && !paused && !reduceMotion) {
				elapsed += delta;
				segs[current]?.style.setProperty('--p', Math.min(elapsed / SLIDE_MS, 1).toFixed(4));
				if (elapsed >= SLIDE_MS) go(current + 1);
			}
			requestAnimationFrame(tick);
		};

		segs.forEach((seg, i) => seg.addEventListener('click', () => go(i)));

		new IntersectionObserver(
			([entry]) => {
				const wasVisible = visible;
				visible = entry.isIntersecting;
				if (visible && !wasVisible && !root.classList.contains('is-locked')) go(current);
			},
			{ threshold: 0.35 }
		).observe(root);

		// Loupe: a magnifier that eases toward the cursor and ramps its zoom up
		// progressively instead of snapping to full magnification.
		if (finePointer) {
			const MAX_ZOOM = 2.4;
			const target = { x: 0, y: 0, zoom: 1 };
			const state = { x: 0, y: 0, zoom: 1 };
			let rect = stage.getBoundingClientRect();
			let raf = 0;

			const render = () => {
				const ease = reduceMotion ? 1 : 0.16;
				state.x += (target.x - state.x) * ease;
				state.y += (target.y - state.y) * ease;
				state.zoom += (target.zoom - state.zoom) * (reduceMotion ? 1 : 0.07);

				const size = loupe.offsetWidth;
				loupe.style.backgroundSize = `${rect.width * state.zoom}px ${rect.height * state.zoom}px`;
				loupe.style.backgroundPosition = `${-(state.x * state.zoom - size / 2)}px ${-(state.y * state.zoom - size / 2)}px`;
				loupe.style.transform = `translate3d(${state.x - size / 2}px, ${state.y - size / 2}px, 0)`;

				const settled =
					Math.abs(target.x - state.x) < 0.2 &&
					Math.abs(target.y - state.y) < 0.2 &&
					Math.abs(target.zoom - state.zoom) < 0.002;
				raf = settled ? 0 : requestAnimationFrame(render);
			};
			const kick = () => {
				if (!raf) raf = requestAnimationFrame(render);
			};
			const pointAt = (event: PointerEvent) => {
				target.x = event.clientX - rect.left;
				target.y = event.clientY - rect.top;
			};

			stage.addEventListener('pointerenter', (event) => {
				rect = stage.getBoundingClientRect();
				pointAt(event);
				state.x = target.x;
				state.y = target.y;
				state.zoom = 1;
				target.zoom = MAX_ZOOM;
				loupe.style.backgroundImage = loupeLayers();
				paused = true;
				root.classList.add('is-loupe');
				kick();
			});
			stage.addEventListener('pointermove', (event) => {
				pointAt(event);
				kick();
			});
			stage.addEventListener('pointerleave', () => {
				target.zoom = 1;
				paused = false;
				root.classList.remove('is-loupe');
				kick();
			});
		}

		root.addEventListener('focusin', () => (paused = true));
		root.addEventListener('focusout', () => (paused = false));

		requestAnimationFrame(tick);
	}
</script>
