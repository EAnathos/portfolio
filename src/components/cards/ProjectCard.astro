---
import { Image } from 'astro:assets';
import type { Project } from '../../data/portfolioData';
import type { Translations } from '../../i18n/translations';
import githubIcon from '../../assets/icons/github.svg?raw';
import globeIcon from '../../assets/icons/globe.svg?raw';
import ProjectPreview from './ProjectPreview.astro';

interface Props {
	project: Project;
	index: number;
	total: number;
	featured?: boolean;
	t: Translations;
	class?: string;
}

const { project, index, total, featured = false, t, class: className = '' } = Astro.props as Props;
const number = String(index + 1).padStart(2, '0');
const totalLabel = String(total).padStart(2, '0');
---

<article
	class:list={['project-card', featured && 'project-card--featured', className]}
	data-project
	data-featured={String(featured)}
	data-tags={project.tags.map((tag) => tag.name).join('|')}
	data-reveal
	style={`--reveal-d:${index * 90}ms`}
>
	<div class="project-card__body">
		<div class="project-card__visual">
			<ProjectPreview project={project} featured={featured} t={t} />
			{featured && <span class="project-card__badge">{t.projects.featured}</span>}
		</div>

		<div class="project-card__content">
			<div class="flex items-center gap-3">
				{project.image ? (
					<Image src={project.image} alt="" width={72} height={72} class="project-card__logo" loading="lazy" />
				) : project.imageSvg ? (
					<span class="project-card__logo" aria-hidden="true" set:html={project.imageSvg}></span>
				) : project.emoji ? (
					<span class="project-card__logo grid place-items-center text-xl" aria-hidden="true">{project.emoji}</span>
				) : null}
				<h3 class="project-card__title">{project.title}</h3>
				<span class="project-card__index" aria-hidden="true">{number}<span>/{totalLabel}</span></span>
			</div>
			<p class="mt-3 text-sm leading-relaxed text-[color:var(--ink-1)]">{project.description}</p>

			<div class="mt-5 flex flex-wrap gap-2">
				{project.tags.map((tag, tagIndex) => (
					<span class="project-tag" data-tag={tag.name} style={`--tag-d:${tagIndex * 45}ms`}>
						{tag.iconSvg ? (
							<span class="inline-flex h-4 w-4" aria-hidden="true" set:html={tag.iconSvg}></span>
						) : tag.icon ? (
							<i class={`text-sm ${tag.icon}`} aria-hidden="true"></i>
						) : null}
						<span>{tag.name}</span>
					</span>
				))}
			</div>

			{project.links && (
				<div class="mt-auto flex flex-wrap gap-2 pt-6">
					{project.links.map((link) => (
						<a href={link.url} target="_blank" rel="noreferrer" class="project-link">
							<span class="inline-flex h-4 w-4" aria-hidden="true" set:html={link.type === 'github' ? githubIcon : globeIcon}></span>
							<span>{link.type === 'github' ? 'GitHub' : 'Site'}</span>
							<svg class="project-link__arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M7 17L17 7M17 7H8M17 7v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span class="sr-only">({project.title})</span>
						</a>
					))}
				</div>
			)}
		</div>
	</div>
</article>
